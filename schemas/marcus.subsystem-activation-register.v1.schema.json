{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wookedemics101-oss/marcus-meta-engine-/blob/main/schemas/marcus.subsystem-activation-register.v1.schema.json",
  "title": "M.A.R.C.U.S. Subsystem Activation Register v1",
  "description": "Machine-readable status for subsystem directive adoption, connection, capability, and runtime activation.",
  "type": "object",
  "required": [
    "registry_version",
    "directive_id",
    "status",
    "activation_policy",
    "subsystems"
  ],
  "additionalProperties": false,
  "properties": {
    "registry_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "directive_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "directive_received",
        "directive_received_and_project_adopted"
      ]
    },
    "activation_policy": {
      "type": "string",
      "minLength": 1
    },
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SubsystemEntry"
      }
    }
  },
  "$defs": {
    "SubsystemEntry": {
      "type": "object",
      "required": [
        "subsystem_id",
        "name",
        "directive_received",
        "operating_principles_adopted",
        "project_state",
        "connection_status",
        "capability_status",
        "execution_status",
        "runtime_activation"
      ],
      "additionalProperties": false,
      "properties": {
        "subsystem_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "directive_received": {
          "type": "boolean"
        },
        "operating_principles_adopted": {
          "type": "boolean"
        },
        "project_state": {
          "type": "string",
          "enum": [
            "active_architecture",
            "inactive",
            "degraded",
            "offline"
          ]
        },
        "connection_status": {
          "type": "string",
          "enum": [
            "not_confirmed",
            "connected",
            "limited",
            "failed"
          ]
        },
        "capability_status": {
          "type": "string",
          "minLength": 1
        },
        "execution_status": {
          "type": "string",
          "enum": [
            "project_level_work_only",
            "partial_execution",
            "confirmed_execution"
          ]
        },
        "runtime_activation": {
          "type": "string",
          "enum": [
            "pending_confirmation",
            "partial",
            "confirmed"
          ]
        }
      }
    }
  }
}
